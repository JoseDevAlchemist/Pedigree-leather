# ---------------------------------------------------------------------------
# Pedigree Leather — environment variables
#
# Copy this file to `.env.local` and fill in the real values. `.env*` is in
# .gitignore, so `.env.local` will never be committed. Only `NEXT_PUBLIC_*`
# variables reach the browser bundle — see the note under the service role key
# before adding anything else here.
# ---------------------------------------------------------------------------

# The project URL. Dashboard → Project Settings → Data API.
# NEXT_PUBLIC_ prefixed: safe in the browser. Next.js inlines it at build time,
# so it must be set *before* the first `pnpm build`, not just before `pnpm dev`.
NEXT_PUBLIC_SUPABASE_URL=

# The anon (a.k.a. "publishable") key. Dashboard → Project Settings → API Keys.
# Safe in the browser *because of RLS*: this key may only do what the policies in
# supabase/migrations/001_initial.sql allow an anonymous visitor to do, which is
# read active products and nothing else. Never give a key wider powers by
# "temporarily" switching it to the service role — see below.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The service role key. Dashboard → Project Settings → API Keys.
#
# NO PREFIX. That is deliberate: Next.js only inlines variables whose name starts
# with NEXT_PUBLIC_, so this one stays on the server.
#
# It bypasses Row Level Security completely and can read and write every row in
# the database. It is referenced in exactly one file, lib/supabase/admin.ts, which
# additionally imports "server-only" so that any attempt to import it from a
# browser component fails the build rather than leaking the key.
#
# If this key is ever exposed — committed, pasted into a client component, sent
# in a log — rotate it immediately in the Dashboard. There is no safe way to
# un-leak a key.
SUPABASE_SERVICE_ROLE_KEY=